  english: THE WHEAT WINDOW
  product: The Wheat Window
  introduction: "\u6c34\u8eca\u304c\u56de\u308b\u6bb5\u4e18\u5712\u3068\u9ea6\u7a93\u306e\u524d\u5ead\u3092\u884c\u304d\u6765\u3057\u3001\u5341\u516d\u7a2e\u306e\u4f5c\u7269\u3092\u80b2\u3066\u3088\u3046\u3002\n\u4e09\u5341\u4e8c\u54c1\u306e\u732e\u7acb\u3067\u3001\u56db\u5b63\u306e\u98df\u5353\u3092\u5f69\u308a\u307e\u3059\u3002"
  controls: "WASD\u30fb\u77e2\u5370\u3067\u6b69\u304f\u3002P\u3067\u7a2e\u3092\u9078\u3073\u3001\u7551\u306e\u524d\u3067E\u3092\u62bc\u3057\u3066\u7a2e\u307e\u304d\u30fb\u6c34\u3084\u308a\u30fb\u53ce\u7a6b\u3002N\u3067\u5c31\u5bdd\u3059\u308b\u3068\u7fcc\u65e5\u306b\u306a\u308a\u307e\u3059\u3002\n\nK \u53a8\u623f\u3000O \u914d\u81b3\u3000M \u58f2\u5e97\u3000B \u5e33\u7c3f\u3000G \u54c1\u8a55\u4f1a\u3002\u53a8\u623f\u3067\u30ec\u30b7\u30d4\u3092\u9078\u3073\u3001\u8868\u793a\u3055\u308c\u305f\u5de5\u7a0b\u3092\u9ec4\u91d1\u306e\u5e2f\u306b\u5408\u308f\u305b\u3066\u4ed5\u4e0a\u3052\u307e\u3059\u3002\nT\u3067\u524d\u5ead\u3068\u6c34\u8eca\u306e\u6bb5\u4e18\u5712\u3092\u79fb\u52d5\u3002\u6bb5\u4e18\u5712\u306f\u5076\u6570\u65e5\u306e\u671d\u306b\u81ea\u52d5\u3067\u6c34\u304c\u5165\u308a\u307e\u3059\u3002"
